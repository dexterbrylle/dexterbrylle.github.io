---
// Stroke arrows drawn inline, so every arrow matches regardless of font subset.
interface Props { dir?: "right" | "left" | "down" | "out" | "cycle" }
const { dir = "right" } = Astro.props;
const paths = {
  right: "M3 8h10M9 4l4 4-4 4",
  left: "M13 8H3M7 4 3 8l4 4",
  down: "M8 3v10M4 9l4 4 4-4",
  out: "M5 11 11 5M6 5h5v5",
  cycle: "M12.5 9.5A4.5 4.5 0 1 1 11.2 5M11.5 2.5V5.2H8.8",
};
---
<svg class="arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={paths[dir]} /></svg>
