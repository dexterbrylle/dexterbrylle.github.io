---
import type { CollectionEntry } from "astro:content";
import Arrow from "./Arrow.astro";

interface Props {
  projects: CollectionEntry<"projects">[];
  showLinks?: boolean;
  startIndex?: number;
}
const { projects, showLinks = false, startIndex = 1 } = Astro.props;
const slug = (project: CollectionEntry<"projects">) => project.id.replace(/\.md$/, "");
const kind = (tags: string[]) => tags.some((tag) => /iphone|ipad/i.test(tag)) ? "ios app" : (tags[0] ?? "project").toLowerCase();
const pad = (n: number) => String(n).padStart(2, "0");
---
{projects.map((project, i) => (
  <article class="card">
    {project.data.preview && <a class="card-media" href={`/building/${slug(project)}/`} tabindex="-1" aria-hidden="true">
      <img src={project.data.preview.src} alt="" width="1200" height="630" loading="lazy" decoding="async" />
    </a>}
    <div class="card-head">
      <a class="card-title" href={`/building/${slug(project)}/`}>{project.data.title}</a>
      <span class="card-meta">{pad(startIndex + i)} / {kind(project.data.tags)}</span>
    </div>
    <p>{project.data.description}</p>
    {showLinks && <div class="card-links">
      {project.data.links.map((link) => <a href={link.href} rel="noreferrer">{new URL(link.href).hostname.replace(/^www\./, "")} <Arrow dir="out" /></a>)}
    </div>}
  </article>
))}
