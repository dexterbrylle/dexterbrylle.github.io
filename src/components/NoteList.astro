---
import type { CollectionEntry } from "astro:content";
import SpiralMark from "./SpiralMark.astro";
interface Props { posts: CollectionEntry<"blog">[]; headingLevel?: "h2" | "h3" }
const { posts, headingLevel: Heading = "h2" } = Astro.props;
const dateFormat = new Intl.DateTimeFormat("en", { month: "short", day: "numeric", year: "numeric", timeZone: "UTC" });
---
<div class="post-list">
  {posts.map((post) => (
    <article class="post-item">
      <div class="post-meta">
        <time datetime={post.data.pubDate.toISOString()}>{dateFormat.format(post.data.pubDate)}</time>
        <span>{post.data.tags.join(" / ")}</span>
      </div>
      <Heading><a class="title-link" href={`/notes/${post.id.replace(/\.md$/, "")}/`}><span>{post.data.title}</span><SpiralMark /></a></Heading>
      <p>{post.data.description}</p>
    </article>
  ))}
</div>
