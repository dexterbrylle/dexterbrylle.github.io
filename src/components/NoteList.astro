---
import type { CollectionEntry } from "astro:content";
interface Props { posts: CollectionEntry<"blog">[]; showTags?: boolean }
const { posts, showTags = false } = Astro.props;
const slug = (post: CollectionEntry<"blog">) => post.id.replace(/\.md$/, "");
const iso = (date: Date) => date.toISOString().slice(0, 10);
---
<ol class="entries">
  {posts.map((post) => (
    <li>
      <div class="entry-main">
        <a class="entry-title" href={`/notes/${slug(post)}/`} style={`view-transition-name: note-${slug(post)}`}>{post.data.title}</a>
        <p class="entry-desc">{post.data.description}</p>
        {showTags && <p class="entry-tags">{post.data.tags.join(" · ")}</p>}
      </div>
      <time class="date" datetime={post.data.pubDate.toISOString()}>{iso(post.data.pubDate)}</time>
    </li>
  ))}
</ol>
