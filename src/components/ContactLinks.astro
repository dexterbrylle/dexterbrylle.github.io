---
import { contact, home } from "../data/site.json";
import Arrow from "./Arrow.astro";
interface Props { label?: string; stacked?: boolean }
const { label = home.contactLabel, stacked = false } = Astro.props;
---
<nav class:list={[stacked ? "identity-links" : "link-row"]} aria-label={label}>
  {contact.map(({ label, href }) => href.startsWith("mailto:")
    ? <a class="strong ink" href={href}>{label}</a>
    : <a href={href} rel="noreferrer">{label.toLowerCase()} <Arrow dir="out" /></a>)}
</nav>
