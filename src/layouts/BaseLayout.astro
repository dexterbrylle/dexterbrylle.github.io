---
import data from "../data/site.json";
import { BUILD_ID } from "../lib/build";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: string;
  headline?: string;
  noindex?: boolean;
}

const { site, nav, footer, labels } = data;
const origin = `https://${site.domain}`;
const {
  title = site.name,
  description = site.statement,
  image = `${origin}/og-image.png`,
  type = "website",
  publishedTime,
  headline = title,
  noindex = false,
} = Astro.props;
const pathname = `${Astro.url.pathname.replace(/\/$/, "")}/`;
const canonical = new URL(pathname, origin).href;
const active = (path: string) => path === "/" ? pathname === path : pathname.startsWith(path);
const primaryNav = nav.filter((item) => item.primary && item.path !== "/");
const moreNav = nav.filter((item) => !item.primary);
const personId = `${origin}/#person`;
const graph = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": `${origin}/#website`, url: origin, name: site.name, description: site.statement },
    {
      "@type": "Person", "@id": personId, name: site.fullName,
      givenName: site.givenName, familyName: site.familyName,
      jobTitle: site.jobTitle, url: origin,
      sameAs: data.contact.filter((link) => link.href.startsWith("https:")).map((link) => link.href),
    },
    {
      "@type": "WebPage", "@id": `${canonical}#webpage`, url: canonical,
      name: title, description, isPartOf: { "@id": `${origin}/#website` }, about: { "@id": personId },
    },
    ...(type === "article" ? [{
      "@type": "Article", "@id": `${canonical}#article`, headline, description,
      url: canonical, image, datePublished: publishedTime,
      author: { "@id": personId }, mainEntityOfPage: { "@id": `${canonical}#webpage` },
    }] : []),
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="theme-color" content="#f5f2ea" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="preload" href="/fonts/geist-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/geist-mono-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <script is:inline>
      (() => {
        let mode = "system";
        try { mode = localStorage.getItem("theme") || "system"; } catch {}
        const dark = mode === "dark" || (mode === "system" && matchMedia("(prefers-color-scheme: dark)").matches);
        document.documentElement.dataset.theme = dark ? "dark" : "light";
        document.documentElement.dataset.themeMode = mode;
      })();
    </script>
    <link rel="stylesheet" href={`/styles/fonts.css?v=${BUILD_ID}`} />
    <link rel="stylesheet" href={`/styles/global.css?v=${BUILD_ID}`} />
    <link rel="stylesheet" href={`/styles/motion.css?v=${BUILD_ID}`} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g, "\\u003c")} />
  </head>
  <body>
    <a class="skip-link" href="#main">{labels.skip}</a>
    <div class="wrap">
      <header class="site-header">
        <a class="site-mark" href="/"><span class="logo-mark" aria-hidden="true">dbm.</span><span>{site.name}</span></a>
        <nav class="site-nav" aria-label={labels.navigation}>
          {primaryNav.map((item) => <a class="nav-primary" href={item.path} aria-current={active(item.path) ? "page" : undefined}>{active(item.path) && <span class="nav-marker" aria-hidden="true"></span>}{item.label.toLowerCase()}</a>)}
          <details class:list={["more-menu", { "menu-only": moreNav.length === 0 }]} data-active={moreNav.some((item) => active(item.path)) || undefined}>
            <summary><span class="nav-extra-label">more</span><span class="nav-menu-label">menu</span> <span class="menu-sign" aria-hidden="true">+</span></summary>
            <div class="more-links">
              <span class="nav-all">
                {primaryNav.map((item) => <a href={item.path} aria-current={active(item.path) ? "page" : undefined}>{item.label.toLowerCase()}</a>)}
              </span>
              {moreNav.map((item) => <a href={item.path} aria-current={active(item.path) ? "page" : undefined}>{item.label.toLowerCase()}</a>)}
            </div>
          </details>
        </nav>
      </header>
    </div>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <div class="wrap">
      <footer class="site-footer">
        <span>{footer.edition}</span>
        <div class="theme-switch" role="group" aria-label={footer.themeLabel}>
          <button type="button" data-mode="system" aria-pressed="true">system</button>
          <button type="button" data-mode="light" aria-pressed="false">light</button>
          <button type="button" data-mode="dark" aria-pressed="false">dark</button>
        </div>
      </footer>
    </div>
    <script>
      const root = document.documentElement;
      const preference = matchMedia("(prefers-color-scheme: dark)");
      const buttons = document.querySelectorAll<HTMLButtonElement>(".theme-switch button");
      const menus = document.querySelectorAll<HTMLDetailsElement>(".more-menu");
      const apply = (mode: string) => {
        const dark = mode === "dark" || (mode === "system" && preference.matches);
        root.dataset.theme = dark ? "dark" : "light";
        root.dataset.themeMode = mode;
        document.querySelector('meta[name="theme-color"]')?.setAttribute("content", dark ? "#1f1f28" : "#f5f2ea");
        for (const button of buttons) button.setAttribute("aria-pressed", String(button.dataset.mode === mode));
      };
      apply(root.dataset.themeMode || "system");
      for (const button of buttons) {
        button.addEventListener("click", () => {
          const mode = button.dataset.mode || "system";
          try { mode === "system" ? localStorage.removeItem("theme") : localStorage.setItem("theme", mode); } catch {}
          const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
          if (document.startViewTransition && !still) document.startViewTransition(() => apply(mode));
          else apply(mode);
        });
      }
      preference.addEventListener("change", () => { if ((root.dataset.themeMode || "system") === "system") apply("system"); });
      document.addEventListener("click", (event) => {
        for (const menu of menus) if (event.target instanceof Node && !menu.contains(event.target)) menu.open = false;
      });
      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape") return;
        for (const menu of menus) {
          if (!menu.open) continue;
          menu.open = false;
          if (event.target instanceof Node && menu.contains(event.target)) menu.querySelector("summary")?.focus();
        }
      });
    </script>
  </body>
</html>
