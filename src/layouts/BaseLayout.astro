---
import data from "../data/site.json";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: string;
  headline?: string;
  noindex?: boolean;
}

const { site, nav, contact, footer, labels } = data;
const origin = `https://${site.domain}`;
const {
  title = site.name,
  description = site.statement,
  image = `${origin}/og-image.png`,
  type = "website",
  publishedTime,
  headline = title,
  noindex = false,
} = Astro.props;
const pathname = `${Astro.url.pathname.replace(/\/$/, "")}/`;
const canonical = new URL(pathname, origin).href;
const active = (path: string) => path === "/" ? pathname === path : pathname.startsWith(path);
const personId = `${origin}/#person`;
const graph = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": `${origin}/#website`, url: origin, name: site.name, description: site.statement },
    {
      "@type": "Person", "@id": personId, name: site.fullName,
      givenName: site.givenName, familyName: site.familyName,
      jobTitle: site.jobTitle, url: origin,
      sameAs: contact.filter((link) => link.href.startsWith("https:")).map((link) => link.href),
    },
    {
      "@type": "WebPage", "@id": `${canonical}#webpage`, url: canonical,
      name: title, description, isPartOf: { "@id": `${origin}/#website` }, about: { "@id": personId },
    },
    ...(type === "article" ? [{
      "@type": "Article", "@id": `${canonical}#article`, headline, description,
      url: canonical, image, datePublished: publishedTime,
      author: { "@id": personId }, mainEntityOfPage: { "@id": `${canonical}#webpage` },
    }] : []),
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? "noindex, follow" : "index, follow"} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="theme-color" content="#fafaf9" />
    <link rel="icon" href="/favicon.svg" />

    <script is:inline>
      document.documentElement.dataset.theme = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
    </script>
    <link rel="stylesheet" href="/styles/global.css" />
    <link rel="stylesheet" href="/styles/motion.css" />
    {pathname === "/" && <script is:inline>
      try {
        if (localStorage.getItem("notebook-visited")) document.documentElement.dataset.returning = "true";
        localStorage.setItem("notebook-visited", "true");
      } catch {}
    </script>}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g, "\\u003c")} />
  </head>
  <body class:list={[{ "reading-page": type === "article" }]}>
    <a class="skip-link" href="#main">{labels.skip}</a>
    <div class="page-shell">
      <header class="site-header">
        <a class="site-mark" href="/">{site.name}</a>
        <nav class="desktop-nav" aria-label={labels.navigation}>
          {nav.map((item) => <a href={item.path} aria-current={active(item.path) ? "page" : undefined}>
            {item.label}
          </a>)}
        </nav>
        <details class="mobile-menu">
          <summary>{labels.menu} <span aria-hidden="true"><svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><path d="M3 8h10M8 3v10" /></svg></span></summary>
          <nav aria-label={labels.navigation}>
            {nav.map((item) => <a href={item.path} aria-current={active(item.path) ? "page" : undefined}>
              {item.label}
            </a>)}
          </nav>
        </details>
        <button class="theme-toggle" type="button" aria-label="Dark mode" aria-pressed="false" hidden>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 4a8 8 0 0 1 0 16Z" fill="currentColor" stroke="none"/></svg>
        </button>
      </header>
      <main id="main" tabindex="-1">

        <slot />
      </main>
      <footer class="site-footer">

        <span class="edition">{footer.edition}</span>
        <nav class="footer-links" aria-label={footer.contactLabel}>
          {contact.map((link) => <a href={link.href}>{link.label}</a>)}
        </nav>
      </footer>
    </div>
    <script>
      const toggle = document.querySelector<HTMLButtonElement>(".theme-toggle");
      const preference = matchMedia("(prefers-color-scheme: dark)");
      const syncTheme = () => {
        const dark = document.documentElement.dataset.theme === "dark";
        toggle?.setAttribute("aria-pressed", String(dark));
        document.querySelector('meta[name="theme-color"]')?.setAttribute("content", dark ? "#151515" : "#fafaf9");
      };
      if (toggle) {
        toggle.hidden = false;
        syncTheme();
        toggle.addEventListener("click", () => {
          const theme = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
          document.documentElement.dataset.theme = theme;
          syncTheme();
        });
        preference.addEventListener("change", () => {
          document.documentElement.dataset.theme = preference.matches ? "dark" : "light";
          syncTheme();
        });
      }
    </script>
  </body>
</html>
