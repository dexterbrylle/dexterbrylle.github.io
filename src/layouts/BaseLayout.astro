---
import data from "../data/site.json";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: string;
  headline?: string;
}

const { site, nav, contact, footer, labels } = data;
const origin = `https://${site.domain}`;
const {
  title = site.name,
  description = site.statement,
  image = `${origin}/og-image.svg`,
  type = "website",
  publishedTime,
  headline = title,
} = Astro.props;
const pathname = `${Astro.url.pathname.replace(/\/$/, "")}/`;
const canonical = new URL(pathname, origin).href;
const active = (path: string) => path === "/" ? pathname === path : pathname.startsWith(path);
const personId = `${origin}/#person`;
const graph = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": `${origin}/#website`, url: origin, name: site.name, description: site.statement },
    {
      "@type": "Person", "@id": personId, name: site.fullName,
      givenName: site.givenName, familyName: site.familyName,
      jobTitle: site.jobTitle, url: origin,
      sameAs: contact.filter((link) => link.href.startsWith("https:")).map((link) => link.href),
    },
    {
      "@type": "WebPage", "@id": `${canonical}#webpage`, url: canonical,
      name: title, description, isPartOf: { "@id": `${origin}/#website` }, about: { "@id": personId },
    },
    ...(type === "article" ? [{
      "@type": "Article", "@id": `${canonical}#article`, headline, description,
      url: canonical, image, datePublished: publishedTime,
      author: { "@id": personId }, mainEntityOfPage: { "@id": `${canonical}#webpage` },
    }] : []),
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="theme-color" content="#F1EFE9" />
    <link rel="icon" href="/favicon.svg" />
    <link rel="preload" href="/fonts/archivo-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/styles/global.css" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(graph).replace(/</g, "\\u003c")} />
  </head>
  <body class:list={[{ "reading-page": type === "article" }]}>
    <a class="skip-link" href="#main">{labels.skip}</a>
    <div class="page-shell">
      <header class="site-header">
        <a class="site-mark" href="/"><span class="mark-symbol" aria-hidden="true">↗</span>{site.name}</a>
        <nav class="desktop-nav" aria-label={labels.navigation}>
          {nav.map((item) => <a href={item.path} aria-current={active(item.path) ? "page" : undefined}>
            <span class="nav-point" aria-hidden="true"></span>{item.label}
          </a>)}
        </nav>
        <details class="mobile-menu">
          <summary>{labels.menu} <span aria-hidden="true">＋</span></summary>
          <nav aria-label={labels.navigation}>
            {nav.map((item) => <a href={item.path} aria-current={active(item.path) ? "page" : undefined}>
              <span class="nav-point" aria-hidden="true"></span>{item.label}
            </a>)}
          </nav>
        </details>
      </header>
      <main id="main" tabindex="-1">
        {type === "article" && <div class="reading-course" aria-hidden="true"><span></span></div>}
        <slot />
      </main>
      <footer class="site-footer">
        <div class="chart-scale" aria-hidden="true"><span class="scale-bar"></span><span class="north-arrow">↑ N</span></div>
        <span class="edition">{footer.edition}</span>
        <nav class="footer-links" aria-label={footer.contactLabel}>
          {contact.map((link) => <a href={link.href}>{link.label}</a>)}
        </nav>
      </footer>
    </div>
  </body>
</html>
