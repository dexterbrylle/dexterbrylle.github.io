---
import { getCollection } from "astro:content";
import SpiralMark from "../components/SpiralMark.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import NoteList from "../components/NoteList.astro";
import ProjectList from "../components/ProjectList.astro";
import { site, home, building } from "../data/site.json";
const posts = (await getCollection("blog")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()).slice(0, 4);
const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order).slice(0, 3);
---
<BaseLayout title={home.title} description={home.description}>
  <section class="intro" aria-labelledby="intro-title">
    <h1 id="intro-title">{home.headline}</h1>
    <p class="profile">{site.statement}</p>
    <p class="author-note">{home.authorLine} <a href="/about/">More about me <SpiralMark /></a></p>
    <p class="notebook-welcome">
      <svg class="welcome-mark" viewBox="0 0 36 28" width="36" height="28" fill="none" aria-hidden="true">
        <path d="M18 24V5M18 5C14 2 8 2 3 4V22C8 20 14 21 18 24C22 21 28 20 33 22V4C28 2 22 2 18 5" />
        <path d="M7 9C10 8 13 9 14 10M7 14C10 13 13 14 14 15M22 10C25 9 28 8 29 9M22 15C25 14 28 13 29 14" />
      </svg>
      <span>A working notebook on software, systems, and security.</span>
    </p>
    <div class="link-row intro-links"><a href="/notes/">Read the notes <SpiralMark /></a><a href="/building/">See what I'm building <SpiralMark /></a></div>
  </section>
  <div class="home-columns">
  <section class="home-notes" aria-labelledby="recent-title">
    <div class="section-heading"><h2 id="recent-title">{home.recentTitle}</h2><a href="/notes/">{home.allNotesLabel} <SpiralMark /></a></div>
    <NoteList posts={posts} headingLevel="h3" />
  </section>
  <section class="home-building" aria-labelledby="building-title">
    <div class="section-heading"><h2 id="building-title">{building.title}</h2><a href="/building/">All projects <SpiralMark /></a></div>
    <ProjectList projects={projects} compact headingLevel="h3" />
    <p class="building-onward">Small apps for everyday things.</p>
  </section>
  </div>
</BaseLayout>
