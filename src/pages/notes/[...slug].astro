---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { notes, site } from "../../data/site.json";
export async function getStaticPaths() {
  return (await getCollection("blog")).map((post) => ({ params: { slug: post.id.replace(/\.md$/, "") }, props: { post } }));
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const contents = headings.filter((heading) => heading.depth <= 3);
const dateFormat = new Intl.DateTimeFormat("en", { month: "long", day: "numeric", year: "numeric", timeZone: "UTC" });
---
<BaseLayout title={`${post.data.title} | ${site.name}`} description={post.data.description} type="article" publishedTime={post.data.pubDate.toISOString()} headline={post.data.title}>
  <div class:list={["article-layout", { "has-contents": contents.length > 0 }]}>
    {contents.length > 0 && <aside class="contents-rail">
      <details open>
        <summary>Contents</summary>
        <nav aria-label="Article contents">
          {contents.map((heading) => <a href={`#${heading.slug}`} data-depth={heading.depth}>{heading.text}</a>)}
        </nav>
      </details>
    </aside>}
  <article class="entry">
    <header class="entry-header">
      <a class="back-link" href="/notes/">{notes.backLabel}</a>
      <p class="post-meta"><time datetime={post.data.pubDate.toISOString()}>{dateFormat.format(post.data.pubDate)}</time><span>{post.data.tags.join(" / ")}</span></p>
      <h1>{post.data.title}</h1><p>{post.data.description}</p>
      <p class="author-note">By <a href="/about/">{site.fullName}</a>, {site.jobTitle}</p>
    </header>
    <div class="prose"><Content /></div>
  </article>
  </div>
  <script>
    const rail = document.querySelector('.contents-rail');
    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.contents-rail a'));
    const sections = links.map((link) => ({ link, heading: document.getElementById(decodeURIComponent(link.hash.slice(1))) }));
    if (rail && sections.length) {
      const details = rail.querySelector('details');
      const compact = matchMedia('(max-width: 760px)');
      const adapt = () => { if (details) details.open = !compact.matches; };
      adapt();
      compact.addEventListener('change', adapt);
      let current: HTMLAnchorElement | undefined;
      const update = () => {
        let active = sections[0];
        for (const section of sections) {
          if (section.heading && section.heading.getBoundingClientRect().top <= 90) active = section;
        }
        if (active && current !== active.link) {
          const bounds = !compact.matches ? rail.getBoundingClientRect() : null;
          const item = bounds ? active.link.getBoundingClientRect() : null;
          current?.removeAttribute('aria-current');
          current = active.link;
          current.setAttribute('aria-current', 'location');
          if (bounds && item) {
            if (item.top < bounds.top + 16) rail.scrollTop += item.top - bounds.top - 16;
            else if (item.bottom > bounds.bottom - 16) rail.scrollTop += item.bottom - bounds.bottom + 16;
          }
        }
      };
      rail.addEventListener('click', (event) => {
        if (event.target instanceof Element && event.target.closest('a') && compact.matches && details) details.open = false;
      });
      let pendingFrame = false;
      window.addEventListener('scroll', () => {
        if (pendingFrame) return;
        pendingFrame = true;
        requestAnimationFrame(() => {
          pendingFrame = false;
          update();
        });
      }, { passive: true });
      update();
    }
  </script>
</BaseLayout>
