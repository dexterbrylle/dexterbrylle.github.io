---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import NoteList from "../../components/NoteList.astro";
import { notes, site } from "../../data/site.json";
const posts = (await getCollection("blog", ({ data }) => !data.unlisted)).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const years = [...new Set(posts.map((post) => post.data.pubDate.getUTCFullYear()))];
---
<BaseLayout title={`Software, Systems & Security Notes | ${site.name}`} description={notes.description}>
  <div class="wrap">
    <header class="page-head">
      <h1>{notes.title}</h1>
      <p>{notes.description}</p>
    </header>
    {years.map((year) => {
      const group = posts.filter((post) => post.data.pubDate.getUTCFullYear() === year);
      return (
        <section class="row" aria-labelledby={`year-${year}`}>
          <h2 class="row-label" id={`year-${year}`}><span class="ink">{year}</span><span>{group.length} {group.length === 1 ? "entry" : "entries"}</span></h2>
          <div class="row-body measure-wide"><NoteList posts={group} showTags /></div>
        </section>
      );
    })}
  </div>
</BaseLayout>
