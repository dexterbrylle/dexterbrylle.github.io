---
import { z } from "astro/zod";
import BaseLayout from "../layouts/BaseLayout.astro";
import Arrow from "../components/Arrow.astro";
import homelab from "../data/homelab.json";
import { site } from "../data/site.json";
const items = z.array(z.object({
  name: z.string(),
  description: z.string(),
  status: z.enum(["unknown", "operational", "degraded", "outage"]),
})).parse(homelab.items);
---
<BaseLayout title={`${homelab.title}: Infrastructure experiments | ${site.name}`} description={homelab.description} noindex={items.length === 0}>
  <div class="wrap">
    <header class="page-head">
      <h1>{homelab.title}</h1>
      <p>{homelab.summary}</p>
    </header>
    <section class="row" aria-labelledby="setup-title">
      <h2 class="row-label" id="setup-title"><span class="ink">setup</span><span>{homelab.tools.join(" · ")}</span></h2>
      <div class="row-body measure">
        <div class="loop"><div class="loop-line">
          {homelab.flow.map((step, i) => <>{i > 0 && <span class="sep"><Arrow /></span>}<span class="node">{step}</span></>)}
        </div></div>
        <p class="muted spaced">{homelab.telemetry.label}: {homelab.telemetry.state.toLowerCase()}. {homelab.telemetry.description}</p>
      </div>
    </section>
    <section class="row" aria-labelledby="inventory-title">
      <h2 class="row-label" id="inventory-title">{homelab.inventoryTitle.toLowerCase()}</h2>
      <div class="row-body measure">
        {items.length ? (
          <dl class="defs">
            {items.map((item) => <><dt>{item.name}</dt><dd class="split"><span>{item.description}</span><span class="status" data-status={item.status}>{homelab.statusLabels[item.status].toLowerCase()}</span></dd></>)}
          </dl>
        ) : (
          <div class="empty">
            <h2>{homelab.emptyState.title}</h2>
            <p>{homelab.emptyState.description}</p>
            <a class="more-link" href={homelab.emptyState.onward.href}>{homelab.emptyState.onward.label.toLowerCase()} <Arrow /></a>
          </div>
        )}
      </div>
    </section>
  </div>
</BaseLayout>
