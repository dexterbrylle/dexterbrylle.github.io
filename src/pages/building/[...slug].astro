---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Arrow from "../../components/Arrow.astro";
import { site } from "../../data/site.json";

export async function getStaticPaths() {
  return (await getCollection("projects")).map((project) => ({ params: { slug: project.id.replace(/\.md$/, "") }, props: { project } }));
}
const { project } = Astro.props;
const { Content } = await render(project);
---
<BaseLayout title={`${project.data.title} | ${site.name}`} description={project.data.description} image={project.data.preview ? new URL(project.data.preview.src, Astro.site).href : undefined}>
  <div class="wrap">
    <div class="row article-head">
      <div class="row-label"><a class="back" href="/building/"><Arrow dir="left" /> building</a></div>
      <header class="row-body measure">
        <div class="title-icon">
          {project.data.icon && <img src={project.data.icon} alt="" width="48" height="48" />}
          <h1>{project.data.title}</h1>
        </div>
        <p class="lede">{project.data.description}</p>
        <p class="meta-line"><span>{project.data.status.toLowerCase()}</span><span>{project.data.tags.join(" · ")}</span></p>
        <div class="link-row">
          {project.data.links.map((link) => <a href={link.href} rel="noreferrer">{link.label.toLowerCase()} <Arrow dir="out" /></a>)}
        </div>
      </header>
    </div>
    <div class="row article">
      <div class="row-label"></div>
      <article class="row-body">
        {project.data.preview && <img class="project-cover" src={project.data.preview.src} alt={project.data.preview.alt} width="1200" height="630" />}
        <div class="prose"><Content /></div>
      </article>
    </div>
  </div>
</BaseLayout>
