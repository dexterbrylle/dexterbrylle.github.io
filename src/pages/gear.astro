---
import BaseLayout from "../layouts/BaseLayout.astro";
import data from "../data/gear.json";
import { site } from "../data/site.json";
---
<BaseLayout title={`${data.title} | ${site.name}`} description={data.description}>
  <header class="page-heading"><h1>{data.title}</h1><p>{data.description}</p></header>
  <p class="gallery-note">Hover or focus to reveal color; select an image for a closer look. Images are illustrative.</p>
  <div class="gear-gallery">
    {data.items.map((item) => <article class="gear-tile">
      <a class="gear-image-link" href={item.image} aria-label={`Open image of ${item.name}`} aria-describedby={`description-${item.image.split('/').pop()}`}>
        <span class="gear-front"><img src={item.image} alt={item.name} width="768" height="512" loading="lazy" /></span>
      </a>
      <p class="gear-category">{item.category}</p>
      <h2 class="gear-caption">{item.name}</h2>
      <p class="gear-description" id={`description-${item.image.split('/').pop()}`}>{item.description}</p>
    </article>)}
  </div>
  <dialog class="gear-viewer" aria-labelledby="viewer-title">
    <button class="viewer-close" type="button" aria-label="Close image">Close</button>
    <img class="viewer-image" src={data.items[0].image} alt={data.items[0].name} />
    <h2 id="viewer-title"></h2>
    <p>Illustrative image</p>
  </dialog>
  <script>
    const viewer = document.querySelector<HTMLDialogElement>(".gear-viewer");
    const image = viewer?.querySelector<HTMLImageElement>(".viewer-image");
    const title = viewer?.querySelector("#viewer-title");
    let opener: HTMLAnchorElement | undefined;
    if (viewer && image && title) {
      for (const link of document.querySelectorAll<HTMLAnchorElement>(".gear-image-link")) {
        link.addEventListener("click", (event) => {
          event.preventDefault();
          opener = link;
          image.src = link.href;
          image.alt = link.querySelector("img")?.alt ?? "Gear";
          title.textContent = image.alt;
          viewer.showModal();
          document.body.style.overflow = "hidden";
        });
      }
      viewer.querySelector("button")?.addEventListener("click", () => viewer.close());
      viewer.addEventListener("click", (event) => { if (event.target === viewer) {
        const rect = viewer.getBoundingClientRect();
        if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) viewer.close();
      }});
      viewer.addEventListener("close", () => { document.body.style.overflow = ""; opener?.focus(); });
    }
  </script>
</BaseLayout>
<style>
  .gear-viewer { width: min(900px, calc(100% - 32px)); max-height: 90dvh; padding: 24px; border: none; border-radius: 12px; background: var(--ground); color: var(--ink); }
  .gear-viewer::backdrop { background: rgb(0 0 0 / .75); }
  .viewer-close { display: block; margin: 0 0 16px auto; min-height: 44px; padding: 8px 16px; background: var(--surface); color: var(--ink); border: 1px solid var(--line); border-radius: 8px; cursor: pointer; font: inherit; }
  .viewer-image { display: block; width: 100%; max-height: 65dvh; object-fit: contain; }
  .gear-viewer h2 { margin-top: 16px; font-size: 1.2rem; }
  .gear-viewer > p { color: var(--muted); font-size: .8rem; margin-top: 8px; }

  .gallery-note { color: var(--muted); margin: -1rem 0 2rem; max-width: 65ch; }
  .gear-gallery { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 36px 28px; }
  .gear-tile { min-width: 0; }
  .gear-image-link { display: block; border-radius: 12px; }
  .gear-front { display: block; aspect-ratio: 1; background: #f5f5f4; border-radius: 12px; overflow: hidden; }
  .gear-front img { display: block; width: 100%; height: 100%; object-fit: contain; }
  .gear-category { color: var(--muted); font-size: .8rem; margin-top: 16px; }
  .gear-caption { font-size: 1rem; margin-top: 4px; }
  .gear-description { color: var(--muted); font-size: .9rem; margin-top: 8px; }
  @media (max-width: 1000px) { .gear-gallery { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 600px) { .gear-gallery { grid-template-columns: 1fr; } }
</style>
